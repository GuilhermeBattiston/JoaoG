# Modelo público. Copie apenas para uma instalação nova; preserve o .env existente.
# Gere APP_KEY uma única vez com php artisan key:generate, sem publicar seu valor.
APP_NAME=JoaoG
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://joao315.devlook.xyz
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# SQLite: omita DB_DATABASE para usar database/database.sqlite nesta instalação.
# Se definir DB_DATABASE, use um caminho absoluto para o banco persistente existente.
DB_CONNECTION=sqlite
# DB_DATABASE=/caminho/real/do/projeto/database/database.sqlite

# Alternativa: use os dados fornecidos pelo painel, somente no .env privado.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
